{
  "name": "cypress-notes-e2e-tests",
  "version": "2.0.0",
  "description": "End-to-end QA automation suite for the Scratch Serverless Notes application using Cypress, ESLint, Gherkin BDD, and GitHub Actions.",
  "scripts": {
    "cy:open": "cypress open",
    "cy:open:tablet": "cypress open --config viewportWidth=767,viewportHeight=480",
    "test": "cypress run",
    "test:public": "cypress run --spec cypress/e2e/publicScenarios.cy.js",
    "test:tablet": "cypress run --config viewportWidth=767,viewportHeight=480 --expose grepTags=@desktop-and-tablet",
    "test:record": "cypress run --record --tag desktop",
    "lint": "eslint cypress/**/*.js cypress.config.js eslint.config.mjs",
    "lint:fix": "eslint cypress/**/*.js cypress.config.js eslint.config.mjs --fix"
  },
  "author": "Luis Fernando Brandão",
  "license": "ISC",
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.3.0",
    "cypress-iframe": "^1.0.1",
    "cypress-mailosaur": "^5.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.0.5",
    "globals": "^17.14.0"
  }
}
