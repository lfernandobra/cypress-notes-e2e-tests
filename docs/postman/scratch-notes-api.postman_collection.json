{
  "info": {
    "name": "Scratch Serverless Notes API",
    "description": "Postman collection mapping the AWS API Gateway endpoints observed during Cypress E2E intercepts against https://notes-serverless-app.com.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://90xbti2sk5.execute-api.eu-central-1.amazonaws.com/prod"
    },
    {
      "key": "noteId",
      "value": ""
    },
    {
      "key": "authHeader",
      "value": "REPLACE_WITH_AWS_SIGV4_OR_BEARER"
    }
  ],
  "item": [
    {
      "name": "List Notes",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "{{authHeader}}" }
        ],
        "url": "{{baseUrl}}/notes"
      }
    },
    {
      "name": "Create Note",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "{{authHeader}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Sample QA note\",\n  \"attachment\": null\n}"
        },
        "url": "{{baseUrl}}/notes"
      }
    },
    {
      "name": "Get Note by ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "{{authHeader}}" }
        ],
        "url": "{{baseUrl}}/notes/{{noteId}}"
      }
    },
    {
      "name": "Update Note",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "{{authHeader}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Updated QA note\",\n  \"attachment\": null\n}"
        },
        "url": "{{baseUrl}}/notes/{{noteId}}"
      }
    },
    {
      "name": "Delete Note",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "{{authHeader}}" }
        ],
        "url": "{{baseUrl}}/notes/{{noteId}}"
      }
    },
    {
      "name": "Submit Billing Charge",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "{{authHeader}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"storage\": 1,\n  \"source\": \"tok_visa\"\n}"
        },
        "url": "{{baseUrl}}/billing"
      }
    }
  ]
}
